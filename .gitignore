# ── Secrets ───────────────────────────────────────────────────────────────
# Never commit these: .env here holds JWT secrets, the Resend + Anthropic API
# keys, the Mongo URI with its password, and INTEGRATION_ENCRYPTION_KEY — which
# decrypts every stored integration credential. Commit .env.example instead.
.env
.env.*
!.env.example
!.env.*.example
*.pem
*.key
!**/public/**/*.key
*.p12
*.pfx
id_rsa*
kubeconfig
kubeconfig.*
*.kubeconfig
.aws/
.kube/config

# ── Dependencies ──────────────────────────────────────────────────────────
node_modules/
cluster-agent/venv/
venv/
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/

# ── Build output ──────────────────────────────────────────────────────────
build/
dist/
.next/
out/
*.tsbuildinfo
coverage/
.nyc_output/

# ── Local state / logs ────────────────────────────────────────────────────
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pids/
*.pid
*.seed
tmp/
.cache/

# ── Editor / OS ───────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
.idea/
*.swp
*.swo
.vscode/*
!.vscode/extensions.json

# ── Helm / charts ─────────────────────────────────────────────────────────
helm/**/charts/
helm/**/Chart.lock
*.tgz

# Pi agent runtime conversation state — not source
.conversations/
pi-agent/.conversations/
