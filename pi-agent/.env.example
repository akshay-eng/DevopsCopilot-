# Port this agent listens on (point authService DEEP_AGENT_URL here).
PORT=8100

# The AIOps platform API the agent's tools call (authService).
PLATFORM_API_URL=http://localhost:5001

# --- Model credentials (only for the models you enable in models.json) ---
# On-prem vLLM usually needs no key; leave blank if so.
VLLM_API_KEY=
OLLAMA_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Bedrock uses the standard AWS credential chain (AWS_* env / profile / role).
