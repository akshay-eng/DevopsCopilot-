# ========================================
# AgentOps Integration Configuration
# ========================================
# Add these variables to your authService/.env file

# AgentOps API URL
# URL of the AgentOps API service (default: http://localhost:8000)
AGENTOPS_API_URL=http://localhost:8000

# AgentOps Dashboard URL
# URL of the AgentOps dashboard frontend (default: http://localhost:3001)
AGENTOPS_DASHBOARD_URL=http://localhost:3001

# AgentOps Service Token
# Secure token for server-to-server authentication between authService and AgentOps
# Generate a strong random token using: openssl rand -hex 32
AGENTOPS_SERVICE_TOKEN=your-secure-service-token-here

# AgentOps Database Password
# Password for the AgentOps PostgreSQL database
AGENTOPS_DB_PASSWORD=agentops_secure_password_here

# ========================================
# Existing Environment Variables
# ========================================
# These should already exist in your .env file

# MongoDB URI
MONGO_DB_URI=mongodb://localhost:27017/devops-copilot

# JWT Secret
JWT_SECRET=your-jwt-secret-here

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000

# Email Service (Resend)
RESEND_API_KEY=your-resend-api-key-here
FROM_EMAIL=noreply@yourdomain.com

# OAuth Configuration (if applicable)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret
