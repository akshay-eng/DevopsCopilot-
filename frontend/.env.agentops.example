# ========================================
# AgentOps Integration Configuration
# ========================================
# Add these variables to your frontend/.env file

# AgentOps Dashboard URL
# URL where the AgentOps dashboard is hosted
REACT_APP_AGENTOPS_DASHBOARD_URL=http://localhost:3001

# ========================================
# Existing Environment Variables
# ========================================
# These should already exist in your .env file

# API URL (authService)
REACT_APP_API_URL=http://localhost:5000
